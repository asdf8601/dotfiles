#!/usr/bin/env python3
"""gh sr (simple review): post a PR review written as a markdown file.

  gh sr md <PR> <file.md> [--dry-run]
                          post the file as your pending review (replacing the one you had)
  gh sr status <PR>       list your pending review's comments and the lines GitHub stored
  gh sr submit <PR> [comment|approve|request-changes] [message]
  gh sr discard <PR>      delete your pending review

<PR> is a number (repo of the current directory) or a PR URL.

In the file, "# path:10-20" or "# path:10" starts a comment on those lines of
the PR head, and the text below it is the comment. A ```suggestion block in
the text replaces those lines. A range outside the PR diff goes in the review
body with its path and lines. Text above the first heading opens the review body.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

HUNK = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
MD_HEADER = re.compile(r"^# (\S+?):(\d+)(?:-(\d+))?\s*$")


def run(*cmd):
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode:
        sys.exit(f"{' '.join(cmd[:3])}: {res.stderr.strip()} {res.stdout.strip()}")
    return res.stdout


def gh_json(*args):
    return json.loads(run("gh", *args))


def parse_pr(arg):
    if m := re.search(r"github\.com/([^/]+/[^/]+)/pull/(\d+)", arg):
        return m[1], int(m[2])
    if m := re.fullmatch(r"#?(\d+)", arg):
        return gh_json("repo", "view", "--json", "nameWithOwner")["nameWithOwner"], int(m[1])
    sys.exit(__doc__)


def commentable_lines(repo, number):
    lines = {}
    for page in gh_json("api", "--paginate", "--slurp", f"repos/{repo}/pulls/{number}/files"):
        for item in page:
            right, n = set(), 0
            for line in (item.get("patch") or "").splitlines():
                if m := HUNK.match(line):
                    n = int(m[3])
                elif line[:1] in (" ", "+"):
                    right.add(n)
                    n += 1
            lines[item["filename"]] = right
    return lines


def parse_md(text):
    """Return the text above the first "# path:line" heading and the sections."""
    preamble, sections, fence = [], [], False
    for line in text.splitlines():
        if line.startswith("```"):
            fence = not fence
        elif not fence and (m := MD_HEADER.match(line)):
            sections.append({"path": m[1], "first": int(m[2]), "last": int(m[3] or m[2]), "body": []})
            continue
        (sections[-1]["body"] if sections else preamble).append(line)
    return "\n".join(preamble).strip(), [{**s, "body": "\n".join(s["body"]).strip()} for s in sections]


def pending_review(repo, number):
    me = run("gh", "api", "user", "--jq", ".login").strip()
    reviews = gh_json("api", "--paginate", "--slurp", f"repos/{repo}/pulls/{number}/reviews")
    mine = [r for page in reviews for r in page if r["state"] == "PENDING" and r["user"]["login"] == me]
    return mine[0] if mine else None


def cmd_md(repo, number, md_file, dry_run):
    head = gh_json("pr", "view", str(number), "--repo", repo, "--json", "headRefOid")["headRefOid"]
    allowed = commentable_lines(repo, number)
    preamble, sections = parse_md(Path(md_file).read_text())
    comments, general = [], [preamble] if preamble else []
    for sec in sections:
        first, last = sec["first"], sec["last"]
        span = f"{first}-{last}" if first != last else str(first)
        if all(n in allowed.get(sec["path"], ()) for n in range(first, last + 1)):
            c = {"path": sec["path"], "line": last, "side": "RIGHT", "body": sec["body"]}
            if first != last:
                c |= {"start_line": first, "start_side": "RIGHT"}
            comments.append(c)
            print(f"{sec['path']}:{span}")
        else:
            general.append(f"`{sec['path']}:{span}` {sec['body']}")
            print(f"{sec['path']}:{span}  (outside the PR diff: goes in the review body)")
    if preamble:
        print("text above the first heading  (goes first in the review body)")
    print(f"{len(comments)} inline comments, {len(general)} in the review body, on {head[:9]}")
    if dry_run:
        return
    if not comments and not general:
        sys.exit("nothing to post")
    if old := pending_review(repo, number):
        run("gh", "api", "--method", "DELETE", f"repos/{repo}/pulls/{number}/reviews/{old['id']}")
    payload = {"commit_id": head, "body": "\n\n".join(general), "comments": comments}
    res = subprocess.run(
        ["gh", "api", "--method", "POST", f"repos/{repo}/pulls/{number}/reviews", "--input", "-"],
        input=json.dumps(payload), capture_output=True, text=True,
    )
    if res.returncode:
        sys.exit(f"posting the review failed: {res.stderr.strip()} {res.stdout.strip()}")
    print(f"pending review posted: https://github.com/{repo}/pull/{number}/files")


def cmd_status(repo, number):
    owner, name = repo.split("/")
    query = (
        "query($o:String!,$n:String!,$pr:Int!){repository(owner:$o,name:$n){pullRequest(number:$pr){"
        "reviews(states:PENDING,first:5){nodes{author{login} comments(first:100){nodes{path startLine line body}}}}}}}"
    )
    data = gh_json("api", "graphql", "-f", f"query={query}", "-F", f"o={owner}", "-F", f"n={name}", "-F", f"pr={number}")
    me = run("gh", "api", "user", "--jq", ".login").strip()
    mine = [r for r in data["data"]["repository"]["pullRequest"]["reviews"]["nodes"] if r["author"]["login"] == me]
    if not mine:
        sys.exit("no pending review")
    for c in mine[0]["comments"]["nodes"]:
        span = f"{c['startLine']}-{c['line']}" if c["startLine"] else str(c["line"])
        print(f"{c['path']}:{span}  {c['body'].splitlines()[0][:70]}")


def cmd_submit(repo, number, event, message):
    if not (review := pending_review(repo, number)):
        sys.exit("no pending review; post one with gh sr md first")
    # The submit body replaces the review body, which holds the comments GitHub could not anchor.
    body = "\n\n".join(b for b in (message, review["body"]) if b)
    fields = ["-f", f"event={event.upper().replace('-', '_')}"] + (["-f", f"body={body}"] if body else [])
    run("gh", "api", "--method", "POST", f"repos/{repo}/pulls/{number}/reviews/{review['id']}/events", *fields)
    print(f"review submitted: https://github.com/{repo}/pull/{number}")


def cmd_discard(repo, number):
    if not (review := pending_review(repo, number)):
        sys.exit("no pending review")
    run("gh", "api", "--method", "DELETE", f"repos/{repo}/pulls/{number}/reviews/{review['id']}")
    print("pending review deleted")


def main():
    args = [a for a in sys.argv[1:] if a != "--dry-run"]
    cmd, rest = (args[0], args[1:]) if args else ("", [])
    if cmd == "md" and len(rest) == 2:
        cmd_md(*parse_pr(rest[0]), rest[1], "--dry-run" in sys.argv)
    elif cmd == "status" and len(rest) == 1:
        cmd_status(*parse_pr(rest[0]))
    elif cmd == "submit" and 1 <= len(rest) <= 3:
        event = rest[1] if len(rest) > 1 else "comment"
        if event not in ("comment", "approve", "request-changes"):
            sys.exit(__doc__)
        cmd_submit(*parse_pr(rest[0]), event, rest[2] if len(rest) > 2 else "")
    elif cmd == "discard" and len(rest) == 1:
        cmd_discard(*parse_pr(rest[0]))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
