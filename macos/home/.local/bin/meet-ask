#!/usr/bin/env bash
# Open Claude on the newest meet-transcribe transcript, to ask questions
# about the call from a split pane while it runs.
#
# Usage: meet-ask [claude options]

dir="$HOME/Documents/meet-transcripts"
latest=$(ls -t "$dir"/*.txt 2>/dev/null | head -1)
[[ -z $latest ]] && { echo "no transcript in $dir, start meet-transcribe first"; exit 1; }

exec claude --add-dir "$dir" --append-system-prompt "A live meeting transcript is at $latest and grows every ~10 s. \
Lines read '[HH:MM:SS] who: text', where 'me' is the user and 'them' is everyone else on the call. \
Each line is a 10 s audio chunk, so a sentence can be split across lines, and the time is when the chunk was transcribed. \
Short lines like 'Thank you.' on a quiet side can be speech-to-text hallucinations. \
Re-read the file before every answer, since it changes between questions. Answer in the language of the question." "$@"
