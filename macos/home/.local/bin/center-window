#!/bin/sh
# Center a window whose title contains TITLE on the main screen.
# With -a ID, waits up to 3s for a matching window whose AeroSpace id is
# greater than ID, so the caller can record the highest id before launching
# the app. Without -a, uses the newest existing match.
# With -z N, presses cmd+= N times on the window to enlarge its font.
# Usage: center-window [-a ID] [-z N] -t TITLE

after=0
zoom=0
title=""
while getopts a:t:z: opt; do
  case $opt in
    a) after=$OPTARG ;;
    t) title=$OPTARG ;;
    z) zoom=$OPTARG ;;
    *) exit 1 ;;
  esac
done
[ -z "$title" ] && { echo "usage: center-window [-a ID] [-z N] -t TITLE" >&2; exit 1; }

newest() {
  aerospace list-windows --all --format '%{window-id}|%{app-pid}|%{window-title}' |
    grep -F "$title" | sort -t'|' -k1,1n | tail -1
}

pid=""
i=0
while [ $i -lt 100 ]; do
  w=$(newest)
  if [ -n "$w" ] && [ "${w%%|*}" -gt "$after" ]; then
    pid=$(echo "$w" | cut -d'|' -f2)
    break
  fi
  sleep 0.03
  i=$((i + 1))
done
[ -z "$pid" ] && { echo "center-window: no new window matching '$title'" >&2; exit 1; }

osascript -l JavaScript - "$pid" "$title" "$zoom" <<'EOF'
ObjC.import("AppKit")
function run(argv) {
  var pid = parseInt(argv[0]), title = argv[1], zoom = parseInt(argv[2])
  var primary = $.NSScreen.screens.objectAtIndex(0).frame
  var vis = $.NSScreen.mainScreen.visibleFrame
  var sx = vis.origin.x, sw = vis.size.width, sh = vis.size.height
  var sy = primary.size.height - vis.origin.y - sh
  var proc = Application("System Events").processes.whose({ unixId: pid })[0]
  var win = proc.windows.whose({ name: { _contains: title } })[0]
  var w = Math.min(1200, sw - 40), h = Math.min(800, sh - 40)
  win.size = [w, h]
  win.position = [Math.round(sx + (sw - w) / 2), Math.round(sy + (sh - h) / 2)]
  proc.frontmost = true
  for (var i = 0; i < zoom; i++) {
    Application("System Events").keystroke("=", { using: "command down" })
  }
  return "centered " + title + " (pid " + pid + ")"
}
EOF
