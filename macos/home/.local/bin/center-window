#!/bin/sh
# Center a window whose title contains TITLE on the main screen.
# Waits up to 3s for a matching window that did not exist at start (so it can
# run right after launching the app), else uses the newest existing match.
# Usage: center-window -t TITLE

[ "$1" = "-t" ] && shift
title="$1"
[ -z "$title" ] && { echo "usage: center-window -t TITLE" >&2; exit 1; }

matches() {
  aerospace list-windows --all --format '%{window-id}|%{app-pid}|%{window-title}' |
    grep -F "$title" | sort -t'|' -k1,1n
}

before=$(matches | cut -d'|' -f1)
pid=""
i=0
while [ $i -lt 100 ]; do
  pid=$(matches | while IFS='|' read -r id p _; do
    echo "$before" | grep -qx "$id" || echo "$p"
  done | tail -1)
  [ -n "$pid" ] && break
  sleep 0.03
  i=$((i + 1))
done
[ -z "$pid" ] && pid=$(matches | tail -1 | cut -d'|' -f2)
[ -z "$pid" ] && { echo "center-window: no window matching '$title'" >&2; exit 1; }

osascript -l JavaScript - "$pid" "$title" <<'EOF'
ObjC.import("AppKit")
function run(argv) {
  var pid = parseInt(argv[0]), title = argv[1]
  var primary = $.NSScreen.screens.objectAtIndex(0).frame
  var vis = $.NSScreen.mainScreen.visibleFrame
  var sx = vis.origin.x, sw = vis.size.width, sh = vis.size.height
  var sy = primary.size.height - vis.origin.y - sh
  var proc = Application("System Events").processes.whose({ unixId: pid })[0]
  var win = proc.windows.whose({ name: { _contains: title } })[0]
  var size = win.size()
  var w = size[0], h = size[1]
  if (w >= sw - 20) {
    w = 1200
    h = 800
    win.size = [w, h]
  }
  win.position = [Math.round(sx + (sw - w) / 2), Math.round(sy + (sh - h) / 2)]
  proc.frontmost = true
  return "centered " + title + " (pid " + pid + ")"
}
EOF
